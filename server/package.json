  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@types/express": "^5.0.6",
    "@types/node": "^20.0.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "socket.io": "^4.8.3",
    "tsx": "^4.21.0",
    "typescript": "^5.4.5",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@vitest/coverage-v8": "^4.1.2",
    "bcryptjs": "^3.0.3",
    "jsonwebtoken": "^9.0.3",
    "prisma": "^5.22.0",
    "vitest": "^4.1.2"
  }
}
